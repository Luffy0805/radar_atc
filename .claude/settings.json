{
  "permissions": {
    "allow": [
      "Bash(python3 tools/check.py *)",
      "Bash(luajit -bl *)",
      "Bash(luajit tools/tests/run.lua *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "WebFetch(domain:content.luanti.org)",
      "WebFetch(domain:api.luanti.org)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/tools/hooks/lua_syntax.sh\"",
            "timeout": 30,
            "statusMessage": "Vérification de la syntaxe Lua"
          }
        ]
      }
    ]
  }
}
